# Database configuration (Pointing to Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codepulse
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# JWT Security
# Base64-encoded, at least 256 bits each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your-base64-access-token-secret
JWT_REFRESH_SECRET=your-base64-refresh-token-secret

# Redis (docker-compose requirepass + app connection)
REDIS_PASSWORD=codepulse_redis_local


